{
  "name": "llm-gateway-connector",
  "displayName": "LLM Gateway Connector",
  "description": "Connect GitHub Copilot Chat to your company's LLM gateway with automatic model discovery",
  "version": "0.1.3",
  "publisher": "D3Cruz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cruzleedan/vscode-llm-gateway"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "copilot",
    "llm",
    "gateway",
    "chat",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "LLM Gateway",
      "properties": {
        "llmGateway.url": {
          "type": "string",
          "default": "",
          "description": "Your LLM Gateway base URL (e.g., https://llmgateway.company.com)",
          "order": 1
        },
        "llmGateway.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key for your LLM Gateway (will be stored securely)",
          "order": 2
        },
        "llmGateway.proxyPort": {
          "type": "number",
          "default": 8000,
          "description": "Local port for the litellm proxy",
          "order": 3
        },
        "llmGateway.autoRefreshModels": {
          "type": "boolean",
          "default": true,
          "description": "Automatically fetch available models from gateway on startup",
          "order": 4
        },
        "llmGateway.dropParams": {
          "type": "array",
          "default": [
            "temperature",
            "top_p"
          ],
          "description": "Parameters to drop from requests (for compatibility)",
          "order": 5
        },
        "llmGateway.litellmPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to litellm executable (leave empty for auto-detect)",
          "order": 6
        }
      }
    },
    "commands": [
      {
        "command": "llmGateway.refreshModels",
        "title": "Refresh Available Models",
        "category": "LLM Gateway"
      },
      {
        "command": "llmGateway.restart",
        "title": "Restart Proxy",
        "category": "LLM Gateway"
      },
      {
        "command": "llmGateway.showStatus",
        "title": "Show Status",
        "category": "LLM Gateway"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0",
    "@vscode/vsce": "^2.22.0"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}
